{
	"name": "silent-whisper",
	"description": "A federated social media platform for the modern age — API server.",
	"author": [
		{
			"name": "Marcello Brito",
			"alias": "Tocka",
			"email": "tocka@tockanest.com",
			"url": "https://tockanest.com"
		}
	],
	"license": "AGPL-3.0",
	"version": "0.2.0",
	"private": true,
	"scripts": {
		"dev": "NODE_ENV=development FEDERATION_ALLOW_PRIVATE_URLS=true bun --watch src/server.ts",
		"email:dev": "NODE_ENV=development email dev --dir src/lib/mail/templates --port 3001",
		"test": "NODE_ENV=test playwright test",
		"test:integration:post": "NODE_ENV=test bun run tests/integration/federation-post-delivery.ts",
		"test:integration:proxy-chain": "NODE_ENV=test bun run tests/integration/proxy-chain.ts",
		"keygen": "bun run src/lib/federation/keygen.ts",
		"docker:generate-keys": "bun run tests/docker/generate-keys.ts",
		"docker:setup-discovery": "docker compose -f tests/docker-compose.yml run --rm setup-discovery",
		"docker:build": "docker compose -f tests/docker-compose.yml --profile init --profile setup --profile test build",
		"docker:up": "docker compose -f tests/docker-compose.yml up -d",
		"docker:down": "docker compose -f tests/docker-compose.yml down",
		"docker:init": "docker compose -f tests/docker-compose.yml --profile init up",
		"docker:test:proxy-chain": "docker compose -f tests/docker-compose.yml run --rm test-runner tests/integration/proxy-chain.ts --proxy http://sipher-b:3001 --target http://sipher-c:3002",
		"docker:test:post-delivery": "docker compose -f tests/docker-compose.yml run --rm test-runner tests/integration/federation-post-delivery.ts --proxy http://sipher-b:3001 --target http://sipher-c:3002",
		"docker:test:discover": "docker compose -f tests/docker-compose.yml run --rm test-runner tests/integration/discover.ts --peer http://sipher-c:3002",
		"test:key": "NODE_ENV=test playwright test tests/federation/key-rotation.e2e.ts",
		"test:federation": "NODE_ENV=test playwright test tests/federation",
		"test:proxy": "NODE_ENV=test playwright test tests/proxy",
		"build:matrix": "cd node_modules/@matrix-org/matrix-sdk-crypto-nodejs && node download-lib.js",
		"start": "NODE_ENV=production bun src/server.ts",
		"db:push": "drizzle-kit push",
		"db:migrate": "bun run db:push && bun run drizzle-kit migrate",
		"db:generate": "auth generate --output src/lib/db/schema/index.ts --yes",
		"db:update": "bun run db:generate && bun run db:push",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.14",
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/openapi": "^1.4.16",
		"@matrix-org/matrix-sdk-crypto-wasm": "^18.9.0",
		"@noble/ciphers": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"@react-email/components": "1.0.12",
		"@react-email/render": "^2.2.0",
		"@react-email/tailwind": "^2.0.7",
		"@scure/bip39": "^2.4.0",
		"better-auth": "^1.7.14",
		"bullmq": "^5.81.5",
		"debug": "^4.4.3",
		"dexie": "^4.4.7",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.4",
		"elysia": "^1.4.30",
		"ioredis": "^5.11.1",
		"minio": "^8.0.7",
		"nodemailer": "^8.0.11",
		"pg": "^8.23.1",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"tweetnacl": "^1.0.3",
		"uuid": "^14.0.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@react-email/preview-server": "^5.2.11",
		"@types/bun": "^1.4.4",
		"@types/debug": "^4.1.13",
		"@types/node": "^25.9.9",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"auth": "^1.7.14",
		"drizzle-kit": "^0.31.11",
		"react-email": "5.2.10",
		"typescript": "^6.0.3"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/tockawaffle/sipher.git"
	},
	"bugs": {
		"url": "https://github.com/tockawaffle/sipher/issues"
	},
	"keywords": [
		"social",
		"media",
		"federated"
	]
}
